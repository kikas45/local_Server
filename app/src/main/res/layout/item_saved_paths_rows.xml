<!-- res/layout/item_download.xml -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:layout_marginTop="8dp"
        android:background="#E9EEF2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/textClo_Demo_Folder"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:elegantTextHeight="true"
            android:ellipsize="end"
            android:focusable="true"
            android:foreground="?selectableItemBackground"
            android:gravity="center|start"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:text="Saved Downloads"
            android:textColor="@color/deep_blue"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/textCopy"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textCopy"
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="2dp"
            android:background="@color/deep_blue"
            android:clickable="true"
            android:elegantTextHeight="true"
            android:ellipsize="end"
            android:focusable="true"
            android:foreground="?actionBarItemBackground"
            android:gravity="center"
            android:text="COPY"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/textLaunchFile"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textLaunchFile"
            android:layout_width="90dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:background="#146217"
            android:clickable="true"
            android:elegantTextHeight="true"
            android:ellipsize="end"
            android:focusable="true"
            android:foreground="?actionBarItemBackground"
            android:gravity="center"
            android:text="LAUNCH"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>