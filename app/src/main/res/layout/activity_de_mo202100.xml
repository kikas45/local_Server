<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parentContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/_15dp"
    tools:context=".additionalSettings.DE_MO_202100">

    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>




    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_bar_root"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/close_bs"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:scaleType="fitXY"
            android:src="@drawable/ic_baseline_arrow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:id="@+id/textTitle"
            style="@style/Theme.RemoteWebViewLight"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="16dp"
            android:gravity="center|start"
            android:maxLines="1"
            android:text="Sever Engine"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="@+id/close_bs"
            app:layout_constraintEnd_toStartOf="@+id/imgCloseDialog"
            app:layout_constraintStart_toEndOf="@+id/close_bs"
            app:layout_constraintTop_toTopOf="@+id/close_bs" />

        <ImageView
            android:id="@+id/imgCloseDialog"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="2dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?selectableItemBackground"
            android:padding="8dp"
            android:src="@drawable/ic_close_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/divider21"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="?android:attr/listDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar_root" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestesScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:visibility="visible"
        tools:visibility="visible"
        android:fitsSystemWindows="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar_root">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <TextView
                android:id="@+id/statusText"
                style="@style/textColorStyle"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:layout_marginTop="8dp"
                android:background="?selectableItemBackground"
                android:clickable="false"
                android:elegantTextHeight="true"
                android:focusable="false"
                android:gravity="start|center"
                android:maxLines="1"
                android:paddingStart="65dp"
                android:text="Status : "
                android:textSize="16sp"
                android:visibility="visible"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/imagShowOnlineStatus"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginEnd="16dp"
                android:alpha="1"
                android:checked="false"
                app:layout_constraintBottom_toBottomOf="@+id/textAutostart"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/textAutostart" />


            <TextView
                android:id="@+id/addressText"
                style="@style/textColorStyle"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:background="?selectableItemBackground"
                android:clickable="false"
                android:elegantTextHeight="true"
                android:focusable="false"
                android:gravity="start|center"
                android:maxLines="1"
                android:paddingStart="65dp"
                android:text="Address: --"
                android:textSize="16sp"
                android:visibility="visible"
                app:layout_constraintEnd_toStartOf="@+id/textCopyIpAdress"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textAutostart"
                tools:visibility="visible" />


            <TextView
                android:id="@+id/textCopyIpAdress"
                android:layout_width="100dp"
                android:layout_height="0dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?selectableItemBackground"
                android:gravity="center"
                android:padding="10dp"
                android:text="Copy"
                android:textColor="@color/deep_blue"
                android:textSize="15sp"
                android:visibility="invisible"
                app:layout_constraintBottom_toBottomOf="@+id/addressText"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/addressText"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/textBrowsePath"
                style="@style/textColorStyle"
                android:layout_width="100dp"
                android:layout_height="0dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?selectableItemBackground"
                android:gravity="center"
                android:padding="10dp"
                android:text="Browse"
                android:textColor="@color/deep_blue"
                android:textSize="15sp"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="@+id/editTextPath"
                app:layout_constraintEnd_toStartOf="@+id/textSaveLocation"
                app:layout_constraintTop_toTopOf="@+id/editTextPath"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/textSaveLocation"
                style="@style/textColorStyle"
                android:layout_width="100dp"
                android:layout_height="0dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?selectableItemBackground"
                android:gravity="center"
                android:padding="10dp"
                android:text="Save"
                android:textColor="@color/deep_blue"
                android:textSize="15sp"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="@+id/editTextPath"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/editTextPath"
                app:layout_constraintVertical_bias="1.0"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/textView17"
                style="@style/textColorStyle"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:layout_marginStart="16dp"
                android:clickable="false"
                android:elegantTextHeight="true"
                android:focusable="false"
                android:gravity="center|start"
                android:paddingStart="10dp"
                android:text="Port:"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtNetworkInfo" />


            <TextView
                android:id="@+id/textDisplayStoragePath"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="2dp"
                android:gravity="center"
                android:padding="5dp"
                android:text="path:  storage path of asoh dhh"
                android:textColor="@color/light_gray"
                android:textSize="12sp"
                android:visibility="invisible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:visibility="visible" />

            <EditText
                android:id="@+id/portInput"
                style="@style/textColorStyle"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:background="@drawable/flag_transparent"
                android:elegantTextHeight="true"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center|start"
                android:hint="Port"
                android:inputType="number"
                android:maxLines="1"
                android:paddingStart="20dp"
                android:text="5678"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="@+id/textView17"
                app:layout_constraintEnd_toStartOf="@+id/textClickSetPort"
                app:layout_constraintStart_toEndOf="@+id/textView17"
                app:layout_constraintTop_toTopOf="@+id/textView17" />


            <TextView
                android:id="@+id/textClickSetPort"
                android:layout_width="100dp"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:elegantTextHeight="true"
                android:focusable="true"
                android:foreground="?selectableItemBackground"
                android:gravity="center"
                android:maxLines="1"
                android:visibility="visible"
                android:text="Set Port"
                android:textColor="@color/deep_blue"
                android:textSize="15sp"
                app:layout_constraintBottom_toBottomOf="@+id/portInput"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/portInput" />


            <View
                android:id="@+id/divider62"
                style="@style/dividerBackColor"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textBrowsePath" />


            <View
                android:id="@+id/divider97"
                style="@style/dividerBackColor"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/addressText"
                tools:visibility="visible" />

            <View
                android:id="@+id/divider94"
                style="@style/dividerBackColor"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textAutostart"
                tools:visibility="visible" />

            <View
                android:id="@+id/divider95"
                style="@style/dividerBackColor"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/statusText"
                tools:visibility="visible" />

            <View
                android:id="@+id/divider96"
                style="@style/dividerBackColor"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textDisplayStoragePath"
                tools:visibility="visible" />

            <View
                android:id="@+id/divider98"
                style="@style/dividerBackColor"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/portInput" />

            <View
                android:id="@+id/divider100"
                style="@style/dividerBackColor"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/addressText" />

            <View
                android:id="@+id/divider93"
                style="@style/dividerBackColor"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:visibility="visible"
                app:layout_constraintBottom_toTopOf="@+id/textView17"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/editTextPath"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="8dp"
                android:autofillHints=""
                android:background="@drawable/flag_transparent"
                android:hint="Enter locations and save"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions|textVisiblePassword"
                android:padding="10dp"
                android:textColor="@color/deep_blue"
                android:textSize="15sp"
                android:visibility="visible"
                app:layout_constraintEnd_toStartOf="@+id/textBrowsePath"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider98" />


            <LinearLayout
                android:id="@+id/linearLayout4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:padding="16dp"
                app:layout_constraintBottom_toTopOf="@+id/textDisplayStoragePath"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider62"
                app:layout_constraintVertical_bias="0.0">

                <TextView
                    android:id="@+id/textViewAllSavedList"
                    style="@style/cardDesignBuyGift222"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:foreground="?selectableItemBackground"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="View All Save Paths"
                    android:textColor="@color/deep_blue"
                    android:visibility="gone"
                    tools:visibility="visible" />


                <TextView
                    android:id="@+id/startServerBtn"
                    style="@style/cardDesignBuyGift"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:foreground="?selectableItemBackground"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="Start Server"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/stopServerBtn"
                    style="@style/cardDesignBuyGift"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:foreground="?selectableItemBackground"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="Stop Server"
                    android:visibility="invisible"
                    tools:visibility="visible" />



                <TextView
                    android:id="@+id/viewWithCustomChrome"
                    style="@style/cardDesignBuyGift"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:foreground="?selectableItemBackground"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="Open With Custom Chrome"
                    android:visibility="invisible"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/viewWithInstalledChrome"
                    style="@style/cardDesignBuyGift"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:foreground="?selectableItemBackground"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="Open With System Chrome"
                    android:visibility="invisible"
                    tools:visibility="visible" />


            </LinearLayout>


            <TextView
                android:id="@+id/textAutostart"
                style="@style/textColorStyle"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:background="?selectableItemBackground"
                android:clickable="false"
                android:focusable="false"
                android:elegantTextHeight="true"
                android:gravity="start|center"
                android:maxLines="1"
                android:visibility="visible"
                android:paddingStart="65dp"
                android:text="Allow Server to Auto Start"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider95" />

            <ImageView
                android:id="@+id/imageView14"
                style="@style/imageStyleColorTint"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:layout_marginStart="20dp"
                android:src="@drawable/ic_wifi_no_internet"
                app:layout_constraintBottom_toBottomOf="@+id/textAutostart"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/textAutostart" />


            <ImageView
                android:id="@+id/imageView61"
                style="@style/imageStyleColorTint"
                android:layout_width="27dp"
                android:visibility="visible"
                android:layout_height="27dp"
                android:layout_marginStart="20dp"
                android:src="@drawable/ic_wifi_settings_icon"
                app:layout_constraintBottom_toBottomOf="@+id/addressText"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textAutostart" />

            <ImageView
                android:id="@+id/imageView32"
                style="@style/imageStyleColorTint"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:visibility="visible"
                android:layout_marginStart="20dp"
                android:src="@drawable/ic_wifi_icon_bar_24"
                app:layout_constraintBottom_toBottomOf="@+id/statusText"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/statusText" />

            <TextView
                android:id="@+id/textSeverState"
                style="@style/textColorStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="9dp"
                android:layout_marginEnd="24dp"
                android:gravity="center|start"
                android:text="---"
                android:textSize="16sp"
                android:visibility="visible"
                app:layout_constraintBottom_toTopOf="@+id/textAutostart"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toEndOf="@+id/statusText"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/txtNetworkInfo"
                style="@style/textColorStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="32dp"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="Network Infos"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider97" />

        </androidx.constraintlayout.widget.ConstraintLayout>




    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>


